modules = ["nodejs-24", "python-base-3.13"]

[env]
REPLIT_EXPO_DEV_DOMAIN = "$REPLIT_DEV_DOMAIN"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[objectStorage]
defaultBucketID = "replit-objstore-eb5327b5-b319-4cf2-a13d-8d2e1c0ea551"

[nix]
channel = "stable-25_05"
