{
  "expo": {
    "name": "Vertex AI",
    "slug": "vertexai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vertexai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vertexai.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Vertex AI को photos attach करने के लिए camera access चाहिए।",
        "NSPhotoLibraryUsageDescription": "Vertex AI को photos attach करने के लिए photo library access चाहिए।",
        "NSMicrophoneUsageDescription": "Vertex AI को voice input के लिए microphone access चाहिए।"
      }
    },
    "android": {
      "package": "com.vertexai.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.VIBRATE"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Vertex AI को messages में photos attach करने के लिए photo library access चाहिए।",
          "cameraPermission": "Vertex AI को messages में photos लेने के लिए camera access चाहिए।",
          "microphonePermission": false
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Vertex AI को voice input के लिए microphone access चाहिए।"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3321011265804128~3793245628"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}